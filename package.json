{
  "name": "yetenbi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "owner:create": "node --env-file-if-exists=.env.local scripts/create-owner.mjs",
    "test:devices": "node --env-file-if-exists=.env.local tests/device-suite.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:accounts": "node --env-file-if-exists=.env.local scripts/create-test-accounts.mjs",
    "app:release": "node --env-file-if-exists=.env.local scripts/release-app.mjs",
    "db:wipe-test": "node --env-file-if-exists=.env.local scripts/wipe-test-data.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.8.1",
    "leaflet": "1.9.4",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "next": "^16.4.3",
    "nodemailer": "^10.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "axe-core": "4.14.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
